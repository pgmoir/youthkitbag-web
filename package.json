{
  "name": "youthkitbag-web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "autotrack": "^2.4.1",
    "axios": "^0.19.2",
    "bson-objectid": "^1.3.1",
    "classnames": "^2.2.6",
    "dayjs": "^1.10.4",
    "lodash": "^4.17.20",
    "md5": "^2.3.0",
    "query-string": "^6.11.1",
    "react": "^16.13.1",
    "react-cookie-consent": "^3.0.0",
    "react-dom": "^16.13.1",
    "react-helmet": "^6.0.0",
    "react-icons": "^4.2.0",
    "react-masonry-css": "^1.0.14",
    "react-redux": "^7.2.0",
    "react-router-dom": "^5.1.2",
    "react-scripts": "^3.4.1",
    "react-scroll": "^1.8.1",
    "redux": "^4.0.5",
    "redux-thunk": "^2.3.0",
    "serve": "^11.3.2",
    "uuid": "^8.3.1"
  },
  "scripts": {
    "format": "prettier \"src/**/*.{js,html}\" --write",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "start": "serve -s build",
    "dev": "REACT_APP_ENV=development react-scripts start && npm run css-watch",
    "build": "REACT_APP_ENV=production GENERATE_SOURCEMAP=false react-scripts build",
    "build:test": "REACT_APP_ENV=test GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "css-build": "node-sass --omit-source-map-url src/sass/youthkitbag.scss public/css/youthkitbag.css",
    "css-watch": "npm run css-build -- --watch"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^9.1.2",
    "@commitlint/config-conventional": "^9.1.2",
    "@fortawesome/fontawesome-free": "^5.13.0",
    "@testing-library/react": "^10.0.2",
    "babel-eslint": "^10.1.0",
    "bulma": "^0.9.1",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.19.0",
    "husky": "^4.2.5",
    "node-sass": "^4.14.1",
    "prettier": "^2.0.2",
    "react-router-hash-link": "^1.2.2",
    "react-test-renderer": "^16.13.1",
    "styled-components": "^5.2.1",
    "typescript": "^3.8.3"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
}
