{
  "name": "youthkitbag-web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "autotrack": "^2.4.1",
    "axios": "^0.19.2",
    "lodash": "^4.17.15",
    "query-string": "^6.11.1",
    "react": "^16.13.1",
    "react-cookie-consent": "^3.0.0",
    "react-dom": "^16.13.1",
    "react-helmet": "^6.0.0",
    "react-redux": "^7.2.0",
    "react-router-dom": "^5.1.2",
    "react-scripts": "^3.4.1",
    "redux": "^4.0.5",
    "redux-thunk": "^2.3.0",
    "serve": "^11.3.0"
  },
  "scripts": {
    "format": "prettier \"src/**/*.{js,html}\" --write",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "start": "serve -s build",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
