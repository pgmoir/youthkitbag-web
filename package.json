{
  "name": "youthkitbag-web",
  "version": "0.1.0",
  "engines": {
    "node": "18.x"
  },
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.1",
    "axios": "1.2.3",
    "bson-objectid": "2.0.4",
    "classnames": "2.3.2",
    "dayjs": "1.11.7",
    "leaflet": "1.9.3",
    "lodash": "4.17.21",
    "md5": "2.3.0",
    "query-string": "8.1.0",
    "react": "18.2.0",
    "react-cookie-consent": "8.0.1",
    "react-dom": "18.2.0",
    "react-helmet": "6.1.0",
    "react-icons": "4.7.1",
    "react-leaflet": "4.2.0",
    "react-masonry-css": "1.0.16",
    "react-redux": "8.0.5",
    "react-router-dom": "6.6.2",
    "react-scripts": "5.0.1",
    "react-scroll": "1.8.9",
    "redux": "4.2.0",
    "redux-thunk": "2.4.2",
    "serve": "14.1.2",
    "uuid": "9.0.0"
  },
  "scripts": {
    "format": "prettier \"src/**/*.{js,html}\" --write",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "start": "serve -s build",
    "dev": "REACT_APP_ENV=development react-scripts start && npm run css-watch",
    "build": "REACT_APP_ENV=production GENERATE_SOURCEMAP=false react-scripts build",
    "build:test": "REACT_APP_ENV=test GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "css-build": "node-sass --omit-source-map-url src/sass/youthkitbag.scss public/css/youthkitbag.css",
    "css-watch": "npm run css-build -- --watch",
    "prepare": "husky install"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.19.1",
    "@commitlint/cli": "17.4.2",
    "@commitlint/config-conventional": "17.4.2",
    "@fortawesome/fontawesome-free": "6.2.1",
    "@testing-library/react": "13.4.0",
    "@typescript-eslint/eslint-plugin": "^5.48.2",
    "@typescript-eslint/parser": "^5.48.2",
    "bulma": "0.9.4",
    "eslint": "8.32.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "7.32.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^9.0.0",
    "husky": "^8.0.0",
    "node-sass": "8.0.0",
    "prettier": "2.8.3",
    "react-router-hash-link": "2.4.3",
    "react-test-renderer": "18.2.0",
    "styled-components": "5.3.6",
    "typescript": "4.9.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm test",
      "pre-push": "npm test",
      "...": "..."
    }
  }
}
